[Desktop Entry]
Type=Application
Name=Text
Comment=Read text documents with the Reader buttons
Exec=/usr/lib/reread/apps/text/reader-text-app -- %f
TryExec=/usr/lib/reread/apps/text/reader-text-app
Icon=reread-text
NoDisplay=true
Terminal=false
Categories=Utility;TextTools;
MimeType=text/plain;text/markdown;text/x-markdown;text/csv;application/json;application/xml;text/xml;
X-ReRead=true

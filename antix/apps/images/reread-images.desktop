[Desktop Entry]
Type=Application
Name=Images
Comment=View images with the Reader buttons
Exec=/usr/lib/reread/apps/images/reader-images-app -- %U
TryExec=/usr/lib/reread/apps/images/reader-images-app
Icon=reread-images
NoDisplay=true
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/jpeg;image/png;image/bmp;image/gif;image/webp;image/tiff;image/svg+xml;image/x-icon;image/vnd.microsoft.icon;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-xbitmap;image/x-xpixmap;
X-ReRead=true

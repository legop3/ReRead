{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Booru settings",
  "description": "Server addresses and account API keys. Reopen Booru after saving. Search for tags and save queries using Explore on the Reader.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hosts"
  ],
  "properties": {
    "hosts": {
      "type": "array",
      "title": "Servers",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "title": "Server",
        "additionalProperties": true,
        "required": [
          "name",
          "url",
          "username",
          "api_key"
        ],
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "maxLength": 80
          },
          "url": {
            "type": "string",
            "title": "HTTPS server URL",
            "pattern": "^https://[a-zA-Z0-9.-]+(?::[0-9]{1,5})?/?$",
            "default": "https://e926.net"
          },
          "username": {
            "type": "string",
            "title": "Username",
            "maxLength": 120
          },
          "api_key": {
            "type": "string",
            "title": "API key",
            "format": "password",
            "maxLength": 512
          }
        }
      }
    }
  }
}

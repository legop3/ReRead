# Intel Reader / Colbert: owner-calibrated physical control map.
# The model-specific match leaves attached keyboards unchanged.
evdev:atkbd:dmi:*:svnIntelCorporation:pnColbert:*
 KEYBOARD_KEY_66=camera
 KEYBOARD_KEY_65=screenlock
 KEYBOARD_KEY_de=power
 KEYBOARD_KEY_a2=playpause
 KEYBOARD_KEY_63=back
 KEYBOARD_KEY_6c=up
 KEYBOARD_KEY_6d=down
 KEYBOARD_KEY_6e=left
 KEYBOARD_KEY_6f=right
 KEYBOARD_KEY_1c=enter
 KEYBOARD_KEY_71=menu
 KEYBOARD_KEY_6a=zoomout
 KEYBOARD_KEY_6b=switchvideomode
 KEYBOARD_KEY_69=zoomin
 KEYBOARD_KEY_68=bookmarks
 KEYBOARD_KEY_67=fastforward
 KEYBOARD_KEY_01=help
 KEYBOARD_KEY_b0=volumeup
 KEYBOARD_KEY_ae=volumedown

// Keep searchable package indexes, using APT's native compressed storage.
Acquire::GzipIndexes "true";
// English package descriptions already exist in the Packages indexes.
Acquire::Languages "none";
// Binary package caches are regenerated from those indexes; avoid SSD duplicates.
Dir::Cache::pkgcache "";
Dir::Cache::srcpkgcache "";
// Keep package indexes, but discard installers after dpkg finishes using them.
// apt-get retains these by default, unlike the interactive apt command.
DPkg::Post-Invoke { "rm -f /var/cache/apt/archives/*.deb /var/cache/apt/archives/partial/*.deb || true"; };
